LXI SP,47FFH

; 16-BIT MULTIPLICATION

LHLD 4530H
XCHG

LHLD 4532H

MOV B,H
MOV C,L

LXI H,0000H
SHLD 4536H

MOV A,B
ORA C
JZ MUL_DONE

MUL_LOOP:
DAD D

JNC NO_CARRY

PUSH H
LHLD 4536H
INX H
SHLD 4536H
POP H

NO_CARRY:
DCX B

MOV A,B
ORA C
JNZ MUL_LOOP

MUL_DONE:
SHLD 4534H

; 16-BIT DIVISION

LHLD 453AH
XCHG

LHLD 4538H

LXI B,0000H

DIV_LOOP:
MOV A,L
SUB E
MOV L,A

MOV A,H
SBB D
MOV H,A

JC DIV_DONE

INX B
JMP DIV_LOOP

DIV_DONE:
DAD D
SHLD 453EH

MOV H,B
MOV L,C
SHLD 453CH

HLT
